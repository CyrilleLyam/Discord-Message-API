{
  "name": "discord-message-api",
  "version": "1.0.0",
  "description": "Small HTTP API that forwards messages to a Discord channel",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
